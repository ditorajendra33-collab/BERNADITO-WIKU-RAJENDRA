            ${item.hseNotes ? `<p class="text-xs text-slate-600 line-clamp-2 bg-spilgreen-50/50 rounded-lg p-2.5 border border-spilgreen-100"><span class="font-bold text-spilgreen-800">Catatan HSE:</span> ${escapeHtml(item.hseNotes)}</p>` : ''}
          </div>
        `;
      }).join('');
    }

    function openDetailModal(recordId) {
