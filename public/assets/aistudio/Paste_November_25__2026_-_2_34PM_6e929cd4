    async function toggleCamera() {
      if (isCameraRunning) await stopCamera();
      else await startCamera();
    }

    async function startCamera() {
      const errorBox = document.getElementById('scanner-error');
      const placeholder = document.getElementById('scanner-placeholder');
      const badge = document.getElementById('camera-status-badge');
      const btnLabel = document.getElementById('btn-camera-label');
      const btnToggle = document.getElementById('btn-toggle-camera');
      errorBox.classList.add('hidden');

      if (typeof Html5Qrcode === 'undefined') {
        showScannerError('Library scanner gagal dimuat. Gunakan pilih area atau input kode manual.');
        return;
      }

      try {
        if (!html5QrCode) html5QrCode = new Html5Qrcode('qr-reader');
        placeholder.classList.add('hidden');
        badge.textContent = 'Mengaktifkan...';
        badge.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700';

        await html5QrCode.start(
          { facingMode: 'environment' },
          { fps: 10, qrbox: { width: 240, height: 240 }, aspectRatio: 1.0 },
          onScanSuccess,
          () => {}
        );

        isCameraRunning = true;
        badge.textContent = 'Scanning Aktif';
        badge.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-spilgreen-100 text-spilgreen-800';
        btnLabel.textContent = 'Hentikan Kamera';
        btnToggle.classList.replace('bg-spilgreen-600', 'bg-slate-800');
        btnToggle.classList.replace('hover:bg-spilgreen-700', 'hover:bg-slate-900');
      } catch (err) {
        placeholder.classList.remove('hidden');
        badge.textContent = 'Kamera Gagal';
        badge.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-700';
        showScannerError('Tidak dapat mengakses kamera (butuh HTTPS/localhost). Gunakan input kode manual atau pilih area dari daftar.');
      }
    }

    async function stopCamera() {
      const placeholder = document.getElementById('scanner-placeholder');
      const badge = document.getElementById('camera-status-badge');
      const btnLabel = document.getElementById('btn-camera-label');
      const btnToggle = document.getElementById('btn-toggle-camera');
      try { if (html5QrCode && isCameraRunning) await html5QrCode.stop(); } catch {}
      isCameraRunning = false;
      placeholder.classList.remove('hidden');
      badge.textContent = 'Kamera Siap';
      badge.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-white border border-spilgreen-200 text-spilgreen-700';
      btnLabel.textContent = 'Mulai Scan Kamera';
      btnToggle.classList.remove('bg-slate-800', 'hover:bg-slate-900');
      btnToggle.classList.add('bg-spilgreen-600', 'hover:bg-spilgreen-700');
    }

    async function scanQrFromFile(input) {
      const file = input.files[0];
      if (!file) return;
      try {
        if (isCameraRunning) await stopCamera();
        const fileScanner = new Html5Qrcode('qr-reader');
        const decodedText = await fileScanner.scanFile(file, true);
        onScanSuccess(decodedText);
      } catch {
        showScannerError('QR/Barcode tidak terbaca dari gambar. Gunakan gambar lebih jelas atau input manual.');
      } finally { input.value = ''; }
    }

    function showScannerError(msg) {
      const box = document.getElementById('scanner-error');
      box.textContent = msg;
      box.classList.remove('hidden');
    }

    function onScanSuccess(decodedText) {
      if (navigator.vibrate) navigator.vibrate(120);
      stopCamera();
      const cleaned = decodedText.trim().toUpperCase();
      showToast(`QR Terbaca: ${cleaned}`);
      selectAreaForSender(cleaned);
    }

    function handleManualSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('manual-area-code');
      const code = input.value.trim().toUpperCase().replace(/\s+/g, '-');
      if (!code) return;
      selectAreaForSender(code);
      input.value = '';
    }

    function selectAreaForSender(code) {
      if (isCameraRunning) stopCamera();

      const found = areas.find(a => a.code.toUpperCase() === code.toUpperCase());
      const customFields = document.getElementById('custom-area-fields');

      if (found) {
        activeSenderArea = { ...found, isCustom: false };
        customFields.classList.add('hidden');
        document.getElementById('custom-area-name').required = false;
        document.getElementById('custom-area-dept').required = false;
      } else {
        activeSenderArea = { code: code.toUpperCase(), name: 'Area Baru (Belum Terdaftar)', dept: 'Pilih Divisi & isi nama area', isCustom: true };
        customFields.classList.remove('hidden');
        document.getElementById('custom-area-name').value = '';
        const selectedDiv = document.getElementById('scanner-division-select').value;
        if (selectedDiv) document.getElementById('custom-area-dept').value = selectedDiv;
        document.getElementById('custom-area-name').required = true;
        document.getElementById('custom-area-dept').required = true;
      }

      senderPhotos = createEmptyPhotos();
      selectedPhotoAspect = 'ringkas';
      document.getElementById('sender-notes').value = '';

      const chosenBranch = document.getElementById('sender-branch-select').value || branches[0];
      document.getElementById('form-branch-select').value = chosenBranch;

      const chosenSender = document.getElementById('sender-name-select').value || localStorage.getItem(STORAGE_KEY_LAST_SENDER) || '';
      document.getElementById('sender-name-input').value = chosenSender;

      document.getElementById('sender-form-area-code').textContent = activeSenderArea.code;
      document.getElementById('sender-form-area-name').textContent = activeSenderArea.name;
      document.getElementById('sender-form-area-dept').textContent = activeSenderArea.dept;

      document.getElementById('sender-step-select').classList.add('hidden');
      document.getElementById('sender-submit-form').classList.remove('hidden');
      document.getElementById('btn-back-to-scanner').classList.remove('hidden');

      renderPhotoUploadUI();
      switchTab('sender');
