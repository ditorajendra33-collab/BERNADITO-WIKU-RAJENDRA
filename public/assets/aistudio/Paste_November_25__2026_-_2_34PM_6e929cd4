    function updateHseLiveScore() {
      const vals = Object.values(hseScores);
      const filled = vals.filter(v => v > 0).length;
      const total = vals.reduce((a, b) => a + b, 0);
      const avg = filled > 0 ? (total / 5).toFixed(1) : '0.0';

      document.getElementById('live-avg-score').textContent = avg;
      document.getElementById('live-total-score').textContent = total;

      const badge = document.getElementById('live-grade-badge');
      if (filled < 5) {
        badge.textContent = `${filled}/5 Aspek Dinilai`;
        badge.className = 'px-3.5 py-1.5 rounded-xl bg-spilgreen-800 text-spilgreen-100 text-xs sm:text-sm font-bold';
      } else {
        const grade = getGradeInfo(Number(avg));
        badge.textContent = grade.label;
        badge.className = `px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-bold ${grade.badgeDark}`;
      }
    }

