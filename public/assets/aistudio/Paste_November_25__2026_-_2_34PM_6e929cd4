            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-[11px] font-bold text-white bg-spilgreen-600 px-2 py-0.5 rounded">${escapeHtml(item.branch)}</span>
                  <span class="text-xs font-bold text-spilgreen-800 bg-spilgreen-100 px-2 py-0.5 rounded">${escapeHtml(item.areaCode)}</span>
                  <span class="text-xs text-slate-400">${formatDateTime(item.timestamp)}</span>
                </div>
                <h4 class="font-bold text-slate-900 text-sm sm:text-base mt-1 truncate">${escapeHtml(item.areaName)}</h4>
                <p class="text-xs text-slate-500">
                  Pengirim: <span class="font-semibold text-slate-700">${escapeHtml(item.senderName)}</span>
                  ${item.hseEvaluator ? ` • Penilai HSE: <span class="font-semibold text-spilgreen-700">${escapeHtml(item.hseEvaluator)}</span>` : ''}
                </p>
              </div>
              <div class="text-right shrink-0 space-y-1">
                ${isPending
                  ? `<span class="inline-block px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-100 text-amber-800">⏳ Menunggu HSE</span>`
                  : `<span class="inline-block px-2.5 py-1 rounded-lg text-xs font-bold ${grade.badgeLight}">${item.avgScore.toFixed(1)} • ${grade.label.split(' ')[0]}</span>`
                }
                ${photosList.length > 0 ? `<div class="text-[11px] font-semibold text-spilgreen-700">📷 ${photosList.length} Foto (${photosList.map(p => p.code).join(', ')})</div>` : ''}
              </div>
