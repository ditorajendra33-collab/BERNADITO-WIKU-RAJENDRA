    function submitHseGrading(e) {
      e.preventDefault();
      const idx = records.findIndex(r => r.id === activeGradingId);
      if (idx === -1) return;

      const missingAspect = FIVE_R_ASPECTS.find(a => !hseScores[a.key]);
      if (missingAspect) {
        showToast(`Beri nilai 1–5 untuk aspek ${missingAspect.title}`);
        return;
      }

      const evaluator = document.getElementById('hse-evaluator-input').value.trim();
      if (!evaluator) {
        showToast('Mohon isi nama penilai Tim HSE');
        return;
      }

      if (!hseTeam.some(h => h.toLowerCase() === evaluator.toLowerCase())) {
        hseTeam.push(evaluator);
        localStorage.setItem(STORAGE_KEY_HSE_TEAM, JSON.stringify(hseTeam));
      }
      localStorage.setItem(STORAGE_KEY_LAST_HSE, evaluator);
      renderAllDropdowns();

      const totalScore = Object.values(hseScores).reduce((a, b) => a + b, 0);
      const avgScore = Number((totalScore / 5).toFixed(1));

      records[idx] = {
        ...records[idx],
        status: 'reviewed',
        scores: { ...hseScores },
        totalScore,
        avgScore,
        hseEvaluator: evaluator,
        hseNotes: document.getElementById('hse-notes-input').value.trim(),
        reviewedAt: new Date().toISOString()
      };

      localStorage.setItem(STORAGE_KEY_RECORDS, JSON.stringify(records));
      updatePendingBadges();
      closeHseGradingForm();
      renderDashboard();
      showToast(`Penilaian HSE tersimpan (Skor ${avgScore}/5.0)!`);
    }

    // ==========================================
    // 7. DASHBOARD REKAPITULASI & EXPORT CSV
    // ==========================================
    function getGradeInfo(avg) {
      if (avg >= 4.5) return { label: 'Sangat Baik (A)', badgeLight: 'bg-spilgreen-100 text-spilgreen-800', badgeDark: 'bg-spilgreen-500 text-white' };
      if (avg >= 3.8) return { label: 'Baik (B)', badgeLight: 'bg-teal-100 text-teal-800', badgeDark: 'bg-teal-600 text-white' };
      if (avg >= 3.0) return { label: 'Cukup (C)', badgeLight: 'bg-amber-100 text-amber-800', badgeDark: 'bg-amber-500 text-white' };
      return { label: 'Perlu Perbaikan (D)', badgeLight: 'bg-rose-100 text-rose-800', badgeDark: 'bg-spilred-600 text-white' };
    }

    function getAuditPhotosList(item) {
      const result = [];
      if (item.photos && typeof item.photos === 'object') {
        FIVE_R_ASPECTS.forEach(asp => {
          if (item.photos[asp.key]) {
            result.push({ code: asp.code, title: asp.title, shortTitle: asp.shortTitle, src: item.photos[asp.key] });
          }
        });
      }
      return result;
    }

    function getFilteredRecords() {
      const search = document.getElementById('filter-search').value.trim().toLowerCase();
      const branchFilter = document.getElementById('filter-branch').value;
      const areaFilter = document.getElementById('filter-area').value;
      const statusFilter = document.getElementById('filter-status').value;
      const gradeFilter = document.getElementById('filter-grade').value;

      return records.filter(item => {
        if (branchFilter && item.branch !== branchFilter) return false;
        if (areaFilter && item.areaCode !== areaFilter) return false;
        if (statusFilter !== 'all' && item.status !== statusFilter) return false;

        if (search) {
          const hay = `${item.branch} ${item.senderName} ${item.hseEvaluator} ${item.areaCode} ${item.areaName} ${item.dept} ${item.senderNotes} ${item.hseNotes}`.toLowerCase();
          if (!hay.includes(search)) return false;
        }

        if (gradeFilter !== 'all') {
          if (item.status !== 'reviewed' || item.avgScore === null) return false;
          if (gradeFilter === 'good' && item.avgScore < 4.0) return false;
          if (gradeFilter === 'fair' && (item.avgScore < 3.0 || item.avgScore >= 4.0)) return false;
          if (gradeFilter === 'poor' && item.avgScore >= 3.0) return false;
        }
        return true;
      });
    }

    function renderDashboard() {
      renderKPIs();
      renderAreaRecap();
      renderHistoryList();
    }

    function renderKPIs() {
      const total = records.length;
      const pending = records.filter(r => r.status === 'pending').length;
      const reviewed = records.filter(r => r.status === 'reviewed' && r.avgScore !== null);

      document.getElementById('kpi-total-audits').textContent = total;
      document.getElementById('kpi-pending-info').textContent = `${pending} menunggu penilaian HSE`;

      if (reviewed.length === 0) {
        document.getElementById('kpi-avg-score').textContent = '0.0';
        document.getElementById('kpi-avg-percent').textContent = 'Skala 5.0 (0%)';
        document.getElementById('kpi-best-area').textContent = '-';
        document.getElementById('kpi-best-score').textContent = '-';
        document.getElementById('kpi-low-count').textContent = '0';
        return;
      }

      const avgAll = reviewed.reduce((sum, r) => sum + r.avgScore, 0) / reviewed.length;
      document.getElementById('kpi-avg-score').textContent = avgAll.toFixed(1);
      document.getElementById('kpi-avg-percent').textContent = `Skala 5.0 (${Math.round((avgAll / 5) * 100)}%)`;

      const areaStats = computeAreaStats();
      const sorted = [...areaStats].sort((a, b) => b.avg - a.avg);
      if (sorted.length > 0) {
        document.getElementById('kpi-best-area').textContent = `${sorted[0].areaName}`;
        document.getElementById('kpi-best-score').textContent = `${sorted[0].branch} • ${sorted[0].avg.toFixed(1)}/5.0`;
      }
      document.getElementById('kpi-low-count').textContent = areaStats.filter(a => a.avg < 3.5).length;
    }

    function computeAreaStats() {
      const map = {};
      records.filter(r => r.status === 'reviewed' && r.scores).forEach(item => {
        const key = `${item.branch}__${item.areaCode}`;
        if (!map[key]) {
          map[key] = {
            branch: item.branch,
            areaCode: item.areaCode,
            areaName: item.areaName,
            dept: item.dept,
            count: 0,
            sumAvg: 0,
            rSums: { ringkas: 0, rapi: 0, resik: 0, rawat: 0, rajin: 0 }
          };
        }
        const entry = map[key];
        entry.count++;
        entry.sumAvg += item.avgScore;
        FIVE_R_ASPECTS.forEach(asp => { entry.rSums[asp.key] += (item.scores[asp.key] || 0); });
      });

      return Object.values(map).map(e => ({
        ...e,
        avg: e.sumAvg / e.count,
        rAvgs: {
          ringkas: (e.rSums.ringkas / e.count).toFixed(1),
          rapi: (e.rSums.rapi / e.count).toFixed(1),
          resik: (e.rSums.resik / e.count).toFixed(1),
          rawat: (e.rSums.rawat / e.count).toFixed(1),
          rajin: (e.rSums.rajin / e.count).toFixed(1)
        }
      })).sort((a, b) => b.avg - a.avg);
    }

    function renderAreaRecap() {
      const container = document.getElementById('area-summary-list');
      const stats = computeAreaStats();
      if (stats.length === 0) {
        container.innerHTML = `<div class="p-8 text-center text-sm text-slate-400">Belum ada laporan yang selesai dinilai oleh Tim HSE.</div>`;
        return;
      }

      container.innerHTML = stats.map(s => {
        const pct = Math.round((s.avg / 5) * 100);
        const barColor = s.avg >= 4.0 ? 'bg-spilgreen-600' : s.avg >= 3.0 ? 'bg-amber-500' : 'bg-spilred-600';
        const scoreColor = s.avg >= 4.0 ? 'text-spilgreen-800 bg-spilgreen-100' : s.avg >= 3.0 ? 'text-amber-700 bg-amber-50' : 'text-spilred-700 bg-rose-50';

        return `
          <div class="p-4 sm:p-5 hover:bg-spilgreen-50/30 transition space-y-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="px-2 py-0.5 rounded bg-spilgreen-600 text-white font-bold text-[11px]">${escapeHtml(s.branch)}</span>
                  <span class="px-2 py-0.5 rounded bg-spilgreen-50 border border-spilgreen-200 text-spilgreen-800 font-bold text-xs">${escapeHtml(s.areaCode)}</span>
                  <span class="text-xs text-slate-400">${s.count}x Dinilai HSE</span>
                </div>
                <h3 class="font-bold text-slate-900 text-sm sm:text-base mt-1">${escapeHtml(s.areaName)}</h3>
                <p class="text-xs text-slate-500">${escapeHtml(s.dept)}</p>
              </div>
              <div class="text-right shrink-0">
                <span class="inline-block px-3 py-1 rounded-xl font-extrabold text-base ${scoreColor}">${s.avg.toFixed(1)}</span>
                <p class="text-[11px] text-slate-400 mt-0.5">${pct}%</p>
              </div>
            </div>
            <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full ${barColor} rounded-full transition-all" style="width: ${pct}%"></div>
            </div>
            <div class="grid grid-cols-5 gap-1.5 text-center">
              ${FIVE_R_ASPECTS.map(asp => `
                <div class="bg-spilgreen-50/50 rounded-lg py-1.5 px-1 border border-spilgreen-100">
                  <div class="text-[10px] font-bold text-spilgreen-700">${asp.code}</div>
                  <div class="text-xs font-extrabold text-slate-800">${s.rAvgs[asp.key]}</div>
                </div>
              `).join('')}
            </div>
          </div>
        `;
      }).join('');
    }

    function renderHistoryList() {
      const list = document.getElementById('audit-history-list');
