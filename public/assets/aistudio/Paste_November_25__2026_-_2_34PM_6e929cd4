    // ==========================================
    // 3. NAVIGASI TAB UTAMA
    // ==========================================
    function switchTab(tabName) {
      if (tabName !== 'sender' && isCameraRunning) {
        stopCamera();
      }

      document.querySelectorAll('.tab-page').forEach(el => el.classList.add('hidden'));
      document.getElementById(`page-${tabName}`).classList.remove('hidden');

      document.querySelectorAll('.nav-btn-desktop').forEach(btn => {
        const active = btn.dataset.nav === tabName;
        btn.className = `nav-btn-desktop px-3.5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-1.5 ${
          active ? 'bg-white text-spilgreen-700 shadow-xs' : 'text-spilgreen-100 hover:text-white'
        }`;
      });

      document.querySelectorAll('.nav-btn-mobile').forEach(btn => {
        const active = btn.dataset.nav === tabName;
        btn.className = `nav-btn-mobile relative flex flex-col items-center justify-center gap-1 text-xs font-semibold transition ${
          active ? 'text-spilgreen-700' : 'text-slate-400 hover:text-slate-600'
        }`;
      });

      if (tabName === 'hse') {
        renderHseQueue();
      } else if (tabName === 'dashboard') {
        renderDashboard();
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updatePendingBadges() {
      const count = records.filter(r => r.status === 'pending').length;
      const dBadge = document.getElementById('badge-pending-desktop');
      const mBadge = document.getElementById('badge-pending-mobile');
      if (count > 0) {
        dBadge.textContent = count;
        mBadge.textContent = count;
        dBadge.classList.remove('hidden');
        mBadge.classList.remove('hidden');
      } else {
        dBadge.classList.add('hidden');
        mBadge.classList.add('hidden');
      }
    }

