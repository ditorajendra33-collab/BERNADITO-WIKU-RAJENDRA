    function handlePhotoUpload(input) {
      const file = input.files[0];
      if (!file) return;
      const targetAspect = selectedPhotoAspect;
      const targetMeta = FIVE_R_ASPECTS.find(a => a.key === targetAspect);

      const reader = new FileReader();
      reader.onload = function (e) {
        const img = new Image();
        img.onload = function () {
          const maxWidth = 680;
          let width = img.width;
          let height = img.height;
          if (width > maxWidth) {
            height = Math.round((height * maxWidth) / width);
            width = maxWidth;
          }
          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          canvas.getContext('2d').drawImage(img, 0, 0, width, height);

          senderPhotos[targetAspect] = canvas.toDataURL('image/jpeg', 0.68);
          renderPhotoUploadUI();
          showToast(`Foto ${targetMeta.code} (${targetMeta.shortTitle}) ditambahkan!`);
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
      input.value = '';
    }

    function removeSenderPhoto(aspectKey) {
      senderPhotos[aspectKey] = '';
      renderPhotoUploadUI();
    }

    function submitSenderReport(e) {
      e.preventDefault();
      if (!activeSenderArea) return;

      const uploadedCount = Object.values(senderPhotos).filter(Boolean).length;
      if (uploadedCount === 0) {
        showToast('Unggah minimal 1 foto bukti 5R untuk dikirim ke Tim HSE!');
        return;
      }

      const branch = document.getElementById('form-branch-select').value;
      const senderName = document.getElementById('sender-name-input').value.trim();
      if (!branch || !senderName) {
        showToast('Lengkapi Cabang/Kantor dan Nama Pengirim');
        return;
      }

      // Simpan pengirim & cabang terakhir
      if (!senders.some(s => s.toLowerCase() === senderName.toLowerCase())) {
        senders.push(senderName);
        localStorage.setItem(STORAGE_KEY_SENDERS, JSON.stringify(senders));
      }
      localStorage.setItem(STORAGE_KEY_LAST_SENDER, senderName);
      localStorage.setItem(STORAGE_KEY_LAST_BRANCH, branch);

      // Simpan area baru jika custom
      let finalAreaName = activeSenderArea.name;
      let finalAreaDept = activeSenderArea.dept;
      if (activeSenderArea.isCustom) {
        finalAreaName = document.getElementById('custom-area-name').value.trim();
        finalAreaDept = document.getElementById('custom-area-dept').value.trim();
        if (!finalAreaName || !finalAreaDept) { showToast('Lengkapi Nama Area & Divisi baru'); return; }
        areas.push({ code: activeSenderArea.code, name: finalAreaName, dept: finalAreaDept, isCustomUser: true });
        localStorage.setItem(STORAGE_KEY_AREAS, JSON.stringify(areas));
      }

      const newReport = {
        id: 'SPIL-' + Date.now().toString().slice(-6),
        status: 'pending',
        timestamp: new Date().toISOString(),
        branch,
        areaCode: activeSenderArea.code,
        areaName: finalAreaName,
        dept: finalAreaDept,
        senderName,
        senderNotes: document.getElementById('sender-notes').value.trim(),
        photos: { ...senderPhotos },
        scores: null,
        totalScore: null,
        avgScore: null,
        hseEvaluator: '',
        hseNotes: '',
        reviewedAt: null
      };

      records.unshift(newReport);
      try {
        localStorage.setItem(STORAGE_KEY_RECORDS, JSON.stringify(records));
      } catch {
        alert('Penyimpanan browser penuh. Hapus beberapa riwayat lama terlebih dahulu.');
        records.shift();
        return;
      }

      renderAllDropdowns();
      renderQuickAreaChips();
      updatePendingBadges();
      resetSenderSelection();
      showToast('Foto 5R berhasil dikirim ke antrean Tim HSE!');
      switchTab('hse');
      setHseStatusFilter('pending');
    }

