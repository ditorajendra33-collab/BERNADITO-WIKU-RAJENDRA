    function exportToCSV() {
      const data = getFilteredRecords();
      if (data.length === 0) { showToast('Tidak ada data untuk diexport'); return; }

      const headers = [
        'ID Laporan', 'Status', 'Tanggal Kirim', 'Cabang / Kantor', 'Kode Area', 'Nama Area', 'Divisi',
        'Nama Pengirim', 'Nama Penilai HSE', 'R1 Ringkas', 'R2 Rapi', 'R3 Resik', 'R4 Rawat', 'R5 Rajin',
        'Total Skor', 'Rata-rata', 'Predikat', 'Keterangan Pengirim', 'Catatan Tim HSE', 'Foto Bukti 5R'
      ];
      const csvRows = [headers.join(',')];

      data.forEach(item => {
        const isRev = item.status === 'reviewed' && item.scores;
        const grade = isRev ? getGradeInfo(item.avgScore).label : 'Menunggu Penilaian HSE';
        const photosList = getAuditPhotosList(item);
        const photoSummary = photosList.length > 0 ? photosList.map(p => `${p.code} ${p.shortTitle}`).join('; ') : 'Tidak Ada';

        const row = [
          item.id,
          isRev ? 'Sudah Dinilai HSE' : 'Menunggu Tim HSE',
          formatDateTime(item.timestamp),
          item.branch,
          item.areaCode,
          item.areaName,
          item.dept,
          item.senderName,
          item.hseEvaluator || '-',
          isRev ? item.scores.ringkas : '-',
          isRev ? item.scores.rapi : '-',
          isRev ? item.scores.resik : '-',
          isRev ? item.scores.rawat : '-',
          isRev ? item.scores.rajin : '-',
          isRev ? item.totalScore : '-',
          isRev ? item.avgScore : '-',
          grade,
          item.senderNotes || '-',
          item.hseNotes || '-',
          photoSummary
        ].map(val => `"${String(val).replace(/"/g, '""')}"`);
        csvRows.push(row.join(','));
      });

      const csvContent = '\uFEFF' + csvRows.join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `rekap-5r-pt-spil-${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
      showToast(`Berhasil export ${data.length} data ke CSV`);
    }

